# Staging environment. Run with: npm run android:staging / npm run ios:staging
# Replace the hosts below with the real staging hosts before building.

API_BASE_URL=https://api-staging.staffsaas.example.com/api/v1
APP_PUBLIC_URL=https://staging.staffsaas.example.com

API_TIMEOUT_MS=20000

APP_ENV=staging
APP_DEBUG=false
APP_DEEP_LINK_SCHEME=staffapp

FCM_ENABLED=true
FCM_ANDROID_CHANNEL_ID=staffsaas_default
