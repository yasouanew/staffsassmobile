# Default environment values (development).
# react-native-config loads `.env` when no ENVFILE is provided, so this file keeps
# `npm run android` / `npm run ios` working out of the box for local development.
# Override per environment with `.env.staging` / `.env.production`.

# Point this at your local Laravel backend.
# 10.0.2.2 only works inside the Android emulator (it NATs to the host loopback).
# A physical device must use the host machine's LAN IP, and Laravel must be bound
# to all interfaces (`php artisan serve --host=0.0.0.0 --port=8000`), otherwise the
# request is refused and the client reports it as "no internet connection".
API_BASE_URL=http://192.168.1.179:8000/api/v1

# Laravel app root without the /api/v1 prefix — used to resolve public disk URLs.
APP_PUBLIC_URL=http://192.168.1.179:8000

# Network timeout in milliseconds.
API_TIMEOUT_MS=15000

APP_ENV=development
APP_DEBUG=true
APP_DEEP_LINK_SCHEME=staffapp

# Firebase config comes from native google-services.json / GoogleService-Info.plist.
FCM_ENABLED=true
FCM_ANDROID_CHANNEL_ID=staffsaas_default
